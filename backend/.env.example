# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173

# MongoDB
# Recommended generic variable used by the application.
MONGODB_URI=mongodb://username:password@host:port
MONGODB_DB_NAME=task_management

# Railway also exposes variables such as MONGO_URL / MONGO_PUBLIC_URL
# depending on the MongoDB service configuration. The backend supports them
# automatically when MONGODB_URI is not defined.
