    {
      "name": "E11-01 Health de la API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });",
              "pm.test(\"Esquema de respuesta\", function () { pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"status\",\"database\"],\"properties\":{\"status\":{\"type\":\"string\"},\"database\":{\"type\":\"string\"}}}); });",
              "// El pipeline puede indicar el nombre de su base temporal; E11 conserva el valor histórico.",
              "pm.test(\"Servicio y MongoDB disponibles\", function () { const body = pm.response.json(); const expectedDatabase = pm.environment.get(\"expectedDatabase\") || \"task_management_e11\"; pm.expect(body.status).to.eql(\"ok\"); pm.expect(body.database).to.eql(expectedDatabase); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "E11-02 Registro de usuario",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString() + Math.floor(Math.random() * 1000000).toString();",
              "pm.collectionVariables.set(\"email\", \"e11-\" + runId + \"@example.test\");",
              "pm.collectionVariables.set(\"name\", \"E11 API \" + runId);",
              "pm.collectionVariables.set(\"password\", \"E11-Api-Test-2026!\");",
              "pm.collectionVariables.set(\"taskTitle\", \"E11 task \" + runId);",
              "pm.collectionVariables.set(\"updatedTaskTitle\", \"E11 task updated \" + runId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });",
              "pm.test(\"Esquema de respuesta\", function () { pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"message\",\"token\"],\"properties\":{\"message\":{\"type\":\"string\"},\"token\":{\"type\":\"string\",\"minLength\":1}}}); });",
              "pm.test(\"Usuario registrado y token recibido\", function () { const body = pm.response.json(); pm.expect(body.message).to.eql(\"Registration Successfully\"); pm.expect(body.token).to.be.a(\"string\").and.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
