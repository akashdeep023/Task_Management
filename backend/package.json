{
  "name": "backend",
  "version": "1.0.0",
  "description": "Task_Management",
  "main": "server.js",
  "engines": {
    "node": "18.17.1"
  },
  "scripts": {
    "test": "jest --runInBand",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:unit": "jest --runInBand --coverage",
    "test:baseline": "node scripts/measure-baseline.cjs",
    "test:ci": "npm run test:baseline && node scripts/check-critical-coverage.cjs --verify-baseline && jest --runInBand --ci --coverage --json --outputFile=reports/unit-tests.json && node scripts/check-critical-coverage.cjs"
  },
